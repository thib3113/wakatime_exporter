{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    ":automergePatch",
    ":automergeMinor"
  ],
  "packageRules": [
    {
      "description": "Never pin our own image: keep the floating tag",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["thib3113/wakatime-exporter"],
      "enabled": false
    }
  ]
}
